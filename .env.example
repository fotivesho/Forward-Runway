# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# ...or the newer publishable key instead of the anon key:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Used ONLY for "Delete my account" (removing the auth user). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL, used for auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# App name (optional). Defaults to "Runway Tomorrow" / "Runway" (short name: ~12 characters max).
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_SHORT_NAME=

# Bank connections (Plaid). Off unless all of these are set. See docs/PLAID.md.
# sandbox | production (or "mock" locally for a built-in fake bank; never used on Vercel production)
PLAID_ENV=
PLAID_CLIENT_ID=
PLAID_SECRET=
# Any random password of 32+ characters (or `openssl rand -base64 32`). Encrypts bank tokens; keep it stable.
PLAID_TOKEN_KEY=
# Only for OAuth banks in production, e.g. https://runwaytomorrow.com/app/accounts
PLAID_REDIRECT_URI=
