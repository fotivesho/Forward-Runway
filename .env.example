# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used ONLY for "Delete my account" (removing the auth user). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL, used for auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# App name (optional). Defaults to the working title "Project Fern" / "Fern".
# Set these at launch, e.g. "Runway Tomorrow" and "Runway Tmrw" (short name: ~12 characters max).
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_SHORT_NAME=
